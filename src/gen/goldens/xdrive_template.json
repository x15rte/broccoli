{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:xdrive.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "mux": {
        "enabled": true
      },
      "protocol": "vless",
      "settings": {
        "address": "xdrive.example.com",
        "encryption": "mlkem768x25519plus.native.1rtt.AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA",
        "id": "11111111-2222-3333-4444-555555555555",
        "port": 443
      },
      "streamSettings": {
        "network": "xdrive",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "xdriveSettings": {
          "remoteFolder": "folder-token",
          "secrets": [
            "one",
            "two"
          ],
          "service": "template",
          "template": {
            "auth": {
              "expiryPath": "data.expires",
              "form": {
                "grant_type": "refresh_token"
              },
              "tokenPath": "data.token",
              "tokenUrl": "https://auth.example.com/token",
              "type": "oauth2"
            },
            "concurrency": 48,
            "delete": {
              "method": "DELETE",
              "url": "https://api.example.com/{folder}/{name}"
            },
            "flatten": true,
            "get": {
              "url": "https://api.example.com/{folder}/{name}"
            },
            "list": {
              "namesRegex": "\"name\":\"([^\"]+)\"",
              "url": "https://api.example.com/{folder}?prefix={prefix}"
            },
            "put": {
              "body": "{\"content\":\"{data}\"}",
              "headers": {
                "X-Frame": "xdrive"
              },
              "method": "POST",
              "url": "https://api.example.com/{folder}/{name}"
            },
            "retry": {
              "rateReason": "error.message",
              "status": [
                429,
                503
              ]
            }
          }
        }
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}