{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:masque.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "mux": {
        "enabled": true
      },
      "protocol": "masque",
      "settings": {
        "address": "masque.example.com",
        "port": 443
      },
      "streamSettings": {
        "masqueSettings": {
          "host": "masque.example.com",
          "path": "/.well-known/masque/ip/*/*/",
          "xmux": {
            "cMaxReuseTimes": 100,
            "hKeepAlivePeriod": 30,
            "hMaxRequestTimes": "1000-2000",
            "hMaxReusableSecs": "1800-3000",
            "maxConnections": "2-4"
          }
        },
        "network": "masque",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {
          "alpn": [
            "h2"
          ],
          "serverName": "masque.example.com"
        }
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}