{
  "api": {
    "listen": "127.0.0.1:10853",
    "services": [
      "ReflectionService",
      "HandlerService",
      "LoggerService",
      "StatsService",
      "RoutingService"
    ],
    "tag": "api"
  },
  "dns": {
    "enableParallelQuery": true,
    "serveExpiredTTL": 86400,
    "serveStale": true,
    "servers": [
      {
        "address": "1.1.1.1"
      },
      {
        "address": "8.8.8.8"
      },
      {
        "address": "localhost",
        "domains": [
          "domain:hy2.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "tag": "in-socks"
    },
    {
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {},
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "tag": "in-http"
    }
  ],
  "log": {
    "access": "none",
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "hysteria",
      "settings": {
        "address": "hy2.example.com",
        "port": 443,
        "version": 2
      },
      "streamSettings": {
        "finalmask": {
          "quicParams": {
            "brutalDisableLossCompensation": true,
            "brutalDown": "200 mbps",
            "brutalUp": "50 mbps",
            "congestion": "brutal",
            "disableChromeParrot": true,
            "disableGSO": true,
            "disableStatelessReset": true
          }
        },
        "hysteriaSettings": {
          "auth": "hy2password",
          "udpIdleTimeout": 60,
          "version": 2
        },
        "network": "hysteria",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {}
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ],
  "policy": {
    "system": {
      "statsInboundDownlink": true,
      "statsInboundUplink": true,
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "routing": {
    "rules": [
      {
        "inboundTag": [
          "in-socks"
        ],
        "network": "udp",
        "outboundTag": "dns-out",
        "port": "53"
      }
    ]
  },
  "stats": {}
}