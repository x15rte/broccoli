{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:hy2.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "hysteria",
      "settings": {
        "address": "hy2.example.com",
        "port": 443,
        "version": 2
      },
      "streamSettings": {
        "finalmask": {
          "quicParams": {
            "brutalDisableLossCompensation": true,
            "brutalDown": "200 mbps",
            "brutalUp": "50 mbps",
            "congestion": "brutal",
            "disableChromeParrot": true,
            "disableGSO": true,
            "disableStatelessReset": true
          }
        },
        "hysteriaSettings": {
          "auth": "hy2password",
          "udpIdleTimeout": 60,
          "version": 2
        },
        "network": "hysteria",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {}
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}