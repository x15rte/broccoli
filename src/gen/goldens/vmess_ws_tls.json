{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:vmess.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "vmess",
      "settings": {
        "address": "vmess.example.com",
        "id": "11111111-2222-3333-4444-555555555555",
        "port": 443,
        "security": "auto"
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {
          "fingerprint": "firefox",
          "serverName": "vmess.example.com"
        },
        "wsSettings": {
          "host": "vmess.example.com",
          "path": "/ws"
        }
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}