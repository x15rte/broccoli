{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:noise-script.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "hysteria",
      "settings": {
        "address": "noise-script.example.com",
        "port": 443,
        "version": 2
      },
      "streamSettings": {
        "finalmask": {
          "udp": [
            {
              "settings": {
                "script": "broccoli-golden-noise.lua"
              },
              "type": "noise"
            }
          ]
        },
        "hysteriaSettings": {
          "auth": "noisescriptpassword",
          "udpIdleTimeout": 60,
          "version": 2
        },
        "network": "hysteria",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {}
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}