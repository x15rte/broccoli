{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:xdrive.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "mux": {
        "enabled": true
      },
      "protocol": "vless",
      "settings": {
        "address": "xdrive.example.com",
        "encryption": "mlkem768x25519plus.native.1rtt.AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA",
        "id": "11111111-2222-3333-4444-555555555555",
        "port": 443
      },
      "streamSettings": {
        "network": "xdrive",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "xdriveSettings": {
          "concurrency": 16,
          "eagerWindowMs": 1000,
          "flushIntervalMs": 10,
          "holeTimeoutMs": 15000,
          "maxPollIntervalMs": 400,
          "pollIntervalMs": 40,
          "remoteFolder": "xdrive-store",
          "segmentBytes": 262144,
          "service": "local",
          "sessionTtlSeconds": 120
        }
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
