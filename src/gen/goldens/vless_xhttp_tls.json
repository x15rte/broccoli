{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:x.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "address": "x.example.com",
        "encryption": "none",
        "id": "11111111-2222-3333-4444-555555555555",
        "port": 443
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {
          "alpn": [
            "h2",
            "http/1.1"
          ],
          "fingerprint": "chrome",
          "serverName": "cdn.example.com"
        },
        "xhttpSettings": {
          "host": "cdn.example.com",
          "mode": "packet-up",
          "path": "/xhttp",
          "scMaxEachPostBytes": 1000000,
          "uplinkChunkSize": "2000-4000",
          "xPaddingBytes": "100-200"
        }
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}