{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:chain.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "hysteria",
      "settings": {
        "address": "chain.example.com",
        "port": 443,
        "version": 2
      },
      "streamSettings": {
        "finalmask": {
          "udp": [
            {
              "settings": {
                "ascii": "prefer_ascii",
                "paddingMax": 64,
                "paddingMin": 1,
                "password": "sudoku-password"
              },
              "type": "sudoku"
            },
            {
              "settings": {
                "interval": "5-10",
                "mode": "intervalLocal,intervalRemote",
                "remoteIPs": [
                  "203.0.113.10/32"
                ],
                "remotePorts": "443,10000-10010"
              },
              "type": "udphop"
            }
          ]
        },
        "hysteriaSettings": {
          "auth": "chainpassword",
          "udpIdleTimeout": 60,
          "version": 2
        },
        "network": "hysteria",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {}
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}