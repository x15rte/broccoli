{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:xdns.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "hysteria",
      "settings": {
        "address": "xdns.example.com",
        "port": 443,
        "version": 2
      },
      "streamSettings": {
        "finalmask": {
          "udp": [
            {
              "settings": {
                "domains": [
                  {
                    "labelLimit": 63,
                    "lenLimit": 255,
                    "names": [
                      "tunnel.example.com"
                    ],
                    "types": [
                      1,
                      28
                    ]
                  }
                ],
                "resolvers": [
                  {
                    "addrs": [
                      "https://dns.example.com/dns-query"
                    ],
                    "quicConfig": {
                      "bbrProfile": "aggressive",
                      "congestion": "bbr",
                      "initConnectionReceiveWindow": 16384,
                      "initStreamReceiveWindow": 16384,
                      "keepAlivePeriod": 10,
                      "maxConnectionReceiveWindow": 16777216,
                      "maxIdleTimeout": 30,
                      "maxIncomingStreams": 100,
                      "maxStreamReceiveWindow": 8388608
                    },
                    "tlsConfig": {
                      "alpn": [
                        "h3"
                      ],
                      "fingerprint": "chrome",
                      "serverName": "dns.example.com"
                    }
                  }
                ]
              },
              "type": "xdns"
            }
          ]
        },
        "hysteriaSettings": {
          "auth": "xdnspassword",
          "udpIdleTimeout": 60,
          "version": 2
        },
        "network": "hysteria",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {}
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}