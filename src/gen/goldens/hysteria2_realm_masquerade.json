{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:realm.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "hysteria",
      "settings": {
        "address": "realm.example.com",
        "port": 443,
        "version": 2
      },
      "streamSettings": {
        "finalmask": {
          "udp": [
            {
              "settings": {
                "ipMode": "v4",
                "portMapping": {
                  "enabled": true,
                  "lifetime": 300,
                  "timeout": 15
                },
                "stunServers": [
                  "stun.example.com:3478"
                ],
                "url": "realm://token@realm.example/id"
              },
              "type": "realm"
            }
          ]
        },
        "hysteriaSettings": {
          "auth": "realmpassword",
          "masquerade": {
            "rewriteHost": true,
            "type": "proxy",
            "url": "https://masq.example.com",
            "xForwarded": true
          },
          "udpIdleTimeout": 60,
          "version": 2
        },
        "network": "hysteria",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {}
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}