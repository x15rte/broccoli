{
  "api": {
    "listen": "127.0.0.1:10853",
    "services": [
      "ReflectionService",
      "HandlerService",
      "LoggerService",
      "StatsService",
      "RoutingService"
    ],
    "tag": "api"
  },
  "dns": {
    "enableParallelQuery": true,
    "serveExpiredTTL": 86400,
    "serveStale": true,
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      }
    ]
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "streamSettings": {
        "finalmask": {
          "tcp": [
            {
              "settings": {
                "allowedSourceIPs": [
                  "ext:geoip.dat:cn",
                  "192.0.2.1"
                ],
                "blockedSourceIPs": [
                  "geoip:private",
                  "203.0.113.0/24"
                ]
              },
              "type": "filter"
            }
          ],
          "udp": [
            {
              "settings": {
                "blockedSourceIPs": [
                  "2001:db8::/32"
                ]
              },
              "type": "filter"
            }
          ]
        }
      },
      "tag": "in-socks"
    },
    {
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {},
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "tag": "in-http"
    }
  ],
  "log": {
    "access": "none",
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ],
  "policy": {
    "system": {
      "statsInboundDownlink": true,
      "statsInboundUplink": true,
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "routing": {
    "rules": [
      {
        "inboundTag": [
          "in-socks"
        ],
        "network": "udp",
        "outboundTag": "dns-out",
        "port": "53"
      }
    ]
  },
  "stats": {}
}