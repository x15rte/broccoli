{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:vless.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "address": "vless.example.com",
        "encryption": "none",
        "id": "11111111-2222-3333-4444-555555555555",
        "port": 443
      },
      "streamSettings": {
        "network": "raw",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {
          "serverName": "vless.example.com",
          "useSystemCA": true
        }
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}