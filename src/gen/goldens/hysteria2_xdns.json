{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:xdns.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "hysteria",
      "settings": {
        "address": "xdns.example.com",
        "port": 443,
        "version": 2
      },
      "streamSettings": {
        "finalmask": {
          "udp": [
            {
              "settings": {
                "domains": [
                  {
                    "edns0": 1232,
                    "labelLimit": 63,
                    "lenLimit": 255,
                    "names": [
                      "tunnel.example.com",
                      "alt.example.com"
                    ],
                    "types": [
                      1,
                      28
                    ]
                  }
                ],
                "extraPoll": 2,
                "resolvers": [
                  {
                    "addrs": [
                      "1.1.1.1",
                      "udp://8.8.8.8:53"
                    ]
                  },
                  {
                    "addrs": [
                      "tcp://9.9.9.9:53"
                    ],
                    "worker": 40
                  }
                ]
              },
              "type": "xdns"
            }
          ]
        },
        "hysteriaSettings": {
          "auth": "xdnspassword",
          "udpIdleTimeout": 60,
          "version": 2
        },
        "network": "hysteria",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {}
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}