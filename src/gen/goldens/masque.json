{
  "dns": {
    "servers": [
      {
        "address": "1.1.1.1",
        "timeoutMs": 8000
      },
      {
        "address": "8.8.8.8",
        "timeoutMs": 8000
      },
      {
        "address": "localhost",
        "domains": [
          "domain:masque.example.com"
        ],
        "skipFallback": true
      }
    ]
  },
  "outbounds": [
    {
      "protocol": "masque",
      "settings": {
        "address": "masque.example.com",
        "port": 443,
        "remoteDNS": [
          "1.1.1.1",
          "2606:4700:4700::1111"
        ]
      },
      "streamSettings": {
        "masqueSettings": {
          "headers": {
            "Authorization": "Basic dXNlcjpzZWNyZXQ=",
            "X-Trace": "1"
          },
          "host": "masque.example.com",
          "path": "/.well-known/masque/ip/{target}/{ipproto}/"
        },
        "network": "masque",
        "security": "tls",
        "sockopt": {
          "domainStrategy": "useip"
        },
        "tlsSettings": {
          "alpn": [
            "h2"
          ],
          "serverName": "masque.example.com"
        }
      },
      "tag": "srv-01234567"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    }
  ]
}