// Generated by build.rs from this template and Cargo's package version.
// The app icon MUST be a name that sorts before every state-icon name below
// (it is a strict prefix of all of them): rc.exe sorts named icon resources
// alphabetically and places named resources before numeric IDs, and Windows
// shows the FIRST RT_GROUP_ICON as the exe's file icon. A numeric `1` here
// lands last and the shell shows BROCCOLI_CORE_RUNNING (the play button)
// instead of the neutral broccoli.
BROCCOLI ICON "@BROCCOLI_ICON_PATH@"
BROCCOLI_STOPPED      ICON "@BROCCOLI_STOPPED_ICON_PATH@"
BROCCOLI_CORE_RUNNING ICON "@BROCCOLI_CORE_RUNNING_ICON_PATH@"
BROCCOLI_TUN          ICON "@BROCCOLI_TUN_ICON_PATH@"
BROCCOLI_ERROR        ICON "@BROCCOLI_ERROR_ICON_PATH@"

1 24 "@BROCCOLI_MANIFEST_PATH@"

1 VERSIONINFO
 FILEVERSION @BROCCOLI_FILE_VERSION_COMMAS@
 PRODUCTVERSION @BROCCOLI_FILE_VERSION_COMMAS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x00040004L
 FILETYPE 0x00000001L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "broccoli\0"
      VALUE "FileDescription", "broccoli - Xray-core GUI\0"
      VALUE "FileVersion", "@BROCCOLI_SEMVER@\0"
      VALUE "InternalName", "broccoli\0"
      VALUE "OriginalFilename", "broccoli.exe\0"
      VALUE "ProductName", "broccoli\0"
      VALUE "ProductVersion", "@BROCCOLI_SEMVER@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
